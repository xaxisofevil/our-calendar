# Our Calendar — production Caddyfile (ARCHITECTURE.md §6)
#
# Terminates TLS for ericb.duckdns.org on :8443 via DuckDNS's DNS-01 ACME
# challenge (no port 80 forward needed — DNS-01 proves domain ownership via
# a TXT record, not an inbound HTTP request). Serves the built frontend
# directly from disk and reverse-proxies only /api/* (including the SSE
# stream at /api/stream, which falls under this same prefix) to the Node
# backend on :3001. Backend never faces the internet directly.
#
# Requires the DUCKDNS_API_TOKEN env var to be set wherever this runs (see
# deploy/ecosystem.config.cjs, which passes it through from PM2's own
# environment at start time — set it once before the first `pm2 start`,
# see ARCHITECTURE.md §6's setup checklist for exactly where to get it and
# how to set it).
#
# Requires the custom-built Caddy binary with the caddy-dns/duckdns plugin
# (the plain winget/caddyserver.com download does NOT include DNS provider
# plugins by default) — see ARCHITECTURE.md §6 for how this was built.

ericb.duckdns.org:8443 {
	tls {
		dns duckdns {env.DUCKDNS_API_TOKEN}
	}

	handle /api/* {
		reverse_proxy localhost:3001
	}

	handle {
		root * C:/Users/ericm/projects/our-calendar/frontend/dist
		try_files {path} /index.html
		file_server

		# Vite's own /assets/* (JS/CSS) are content-hashed in their filename
		# (e.g. index-CcNxZBD-.js) — safe to cache aggressively/forever,
		# since any content change produces a brand-new URL.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		# Everything else served here (icons/, manifest.json, index.html,
		# sw.js, favicon.svg) keeps the SAME filename even when its content
		# changes — e.g. replacing an icon PNG in place. Without an explicit
		# header, browsers apply their own heuristic freshness lifetime and
		# can keep serving old bytes for a surprisingly long time under the
		# same URL (this happened for real: an icon update didn't show up
		# on an installed PWA until this was added). `no-cache` still lets
		# the browser cache the file, but forces an ETag revalidation
		# request every time — cheap on a home connection, and the
		# service-worker file specifically *must* never be aggressively
		# cached or its own update mechanism breaks.
		@revalidate path /icons/* /manifest.json /index.html /sw.js /registerSW.js /favicon.svg
		header @revalidate Cache-Control "no-cache"
	}

	encode gzip
}
