node_modules/
dist/
*.log
.env
.env.local
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Agent worktrees are throwaway scratch checkouts, not part of history
.claude/worktrees/

# calendar-add skill's run manifests -- real household data (which real
# events were created when), not something to version-control
.claude/skills/calendar-add/runs/

# Playwright (e2e/, see playwright.config.ts)
/playwright-report/
/test-results/
/blob-report/
backend/data-e2e/

# Vitest (backend/vitest.config.ts) — each batches.test.ts run mints its own
# throwaway DB_DIR_NAME (data-vitest-<uuid>) and removes it in afterAll;
# this is just belt-and-suspenders in case a run is killed mid-test.
backend/data-vitest*/

# Generated by e2e/auth.setup.ts (see playwright.config.ts's "setup"
# project) — holds a live e2e-only session cookie, regenerated every run.
e2e/.auth/

# Personal, machine/checkout-local test config for lib/claudeCli.ts's
# CLAUDE_MCP_CONFIG_PATH lever (ARCHITECTURE.md §10) — contains an absolute
# path tied to one specific worktree checkout location, not portable,
# regenerate it locally rather than commit it.
backend/voicetest-mcp-config.json
