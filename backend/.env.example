# Copy to backend/.env (already gitignored — never commit the real file)
# and fill in a real value. See ARCHITECTURE.md §5/§12 and
# src/middleware/requireAuth.ts.

# Shared household passcode for POST /api/auth/login. Compared via a hashed,
# constant-time check (src/lib/auth.ts) — never logged, never sent back to
# the frontend, never hardcoded in source.
#
# If this is left unset, the backend runs with auth effectively disabled
# (every /api/* route stays open, same as before this feature existed) —
# see requireAuth.ts's comment for why that's the deliberate default rather
# than a hard failure. Set a real value here before relying on the passcode
# gate for actual remote access.
AUTH_PASSCODE=
