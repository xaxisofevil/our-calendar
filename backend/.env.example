# Copy to backend/.env (already gitignored — never commit the real file)
# and fill in a real value. See ARCHITECTURE.md §5/§12 and
# src/middleware/requireAuth.ts.

# Shared household passcode for POST /api/auth/login. Compared via a hashed,
# constant-time check (src/lib/auth.ts) — never logged, never sent back to
# the frontend, never hardcoded in source.
#
# Local development retains an unauthenticated escape hatch when this is
# unset. Production (`NODE_ENV=production`) fails closed at startup instead
# of opening /api/* after a configuration mistake.
AUTH_PASSCODE=

# ARCHITECTURE.md §8a/§14 M5 — Web Push (VAPID) keypair for sending
# reminder notifications (src/lib/reminders.ts). Not tied to any external
# account — just a public/private EC keypair the `web-push` package
# generates and signs outgoing pushes with, so push services (Apple/Google/
# Mozilla's, depending on the browser) can verify this server is who it
# claims to be. Generate a fresh pair once with:
#
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
#
# VAPID_PUBLIC_KEY is not secret — it also needs to reach the frontend build
# (see frontend/.env.example's VITE_VAPID_PUBLIC_KEY, which should be set to
# the same value) so the browser can pass it to `pushManager.subscribe()`.
# VAPID_PRIVATE_KEY IS secret — never commit it, never send it to the
# frontend.
#
# Like AUTH_PASSCODE above, leaving either of these unset doesn't crash the
# backend — the reminder scan (lib/reminders.ts) just silently no-ops until
# both are set, same "auth effectively disabled until configured" pattern.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional. A "mailto:" or "https:" contact URI some push services use to
# reach the sender if this server is misbehaving (e.g. sending too much).
# Defaults to a placeholder if unset — see lib/reminders.ts.
VAPID_SUBJECT=

# ARCHITECTURE.md §9 (M7) — Deepgram API key for POST /api/voice/transcribe
# (src/lib/deepgram.ts), Deepgram's pre-recorded transcription REST
# endpoint. Get one at https://console.deepgram.com (a free-tier key is
# enough for a household's push-to-talk usage). Unlike VAPID above, there is
# no automatic no-op fallback if this is left unset — a request to
# POST /api/voice/transcribe returns a clear 500 ("Voice transcription
# isn't set up yet.") instead, since transcription can't degrade to
# "silently do nothing" the way a background push scan can.
DEEPGRAM_API_KEY=

# Advanced/dev only — overrides the Deepgram endpoint URL. Never needed for
# real usage (the default is the real Deepgram endpoint); exists purely so
# the isolated e2e suite can point this at a local mock server instead of a
# real Deepgram account (see e2e/mock-deepgram-server.mjs). Leave unset.
DEEPGRAM_API_URL=

# ARCHITECTURE.md §10/§12 (M8) — a long-lived OAuth token authenticating
# POST /api/voice/command's spawned `claude -p` invocations
# (src/lib/claudeCli.ts) against your existing Claude subscription (Pro/
# Max/Team/Enterprise), NOT metered per-token API billing — that
# distinction is the whole reason §10 corrected away from a raw
# ANTHROPIC_API_KEY (see ARCHITECTURE.md §10's "Billing" note). Generate
# one once with:
#
#   claude setup-token
#
# Unlike VAPID_*/AUTH_PASSCODE above, there is no automatic no-op fallback
# if this is left unset — POST /api/voice/command returns a clear 500
# ("Voice commands aren't set up yet.") instead, same reasoning as
# DEEPGRAM_API_KEY above: a voice command that silently did nothing would
# be a worse, more confusing failure than an honest "not configured yet".
CLAUDE_CODE_OAUTH_TOKEN=

# Absolute path to a trusted MCP config. Mandatory in production: every
# voice invocation uses --strict-mcp-config so an ambient user-scoped MCP
# registration cannot silently point at another checkout/database. The PM2
# config defaults to deploy/claude-mcp.production.json; verify its absolute
# paths after moving the deployment.
CLAUDE_MCP_CONFIG_PATH=

# Operational kill switch for the whole voice command feature (routes/voice.ts).
# Every /api/voice/* route returns a clean 503 while this is set. Leave unset
# for the normal, always-on state — only set it to the literal string "false"
# to disable voice (e.g. reacting to a bad rollout or an upstream Claude/
# Deepgram incident without a full redeploy). Requires a backend restart to
# take effect; there is no live/in-app toggle.
VOICE_ENABLED=

# Advanced/dev only — both override which "claude" invocation
# src/lib/claudeCli.ts spawns; never needed for real usage (the default is
# the real `claude` binary on PATH, no prefix args). Exist purely so the
# isolated e2e suite can point this at a local, deterministic stand-in
# instead of a real (slow, costly, nondeterministic) Claude Code
# invocation — see e2e/mock-claude-cli.mjs. Leave both unset.
CLAUDE_CLI_COMMAND=
CLAUDE_CLI_ARGS_PREFIX=
